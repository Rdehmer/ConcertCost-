# Copy this file to .env.local and fill in your values.
# In Supabase: open the ConcertCosts project → Connect or Settings → API Keys
# Copy the Project URL and the publishable (or anon public) key.
# Never put a service role / secret key here.

NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
